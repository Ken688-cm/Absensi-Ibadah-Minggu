rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'samuelchristianwijaya26@gmail.com'
        && request.auth.token.email_verified == true;
    }
    match /absensi/{id} {
      // Mahasiswa hanya boleh MEMBUAT dokumen "uid_minggu" -> otomatis 1x per minggu
      allow create: if request.auth != null
        && id == request.auth.uid + '_' + request.resource.data.minggu
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.waktu == request.time
        && request.resource.data.keys().hasOnly(['uid','email','nama','prodi','prodiNorm','stambuk','lat','lng','akurasi','minggu','waktu'])
        && request.resource.data.nama.size() <= 100
        && request.resource.data.prodi.size() <= 100;
      allow get: if request.auth != null && id.matches(request.auth.uid + '_.*');
      allow list, delete: if isAdmin();
      allow get: if isAdmin();
    }
  }
}
